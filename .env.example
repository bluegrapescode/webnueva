# La Isla Nublar web backend environment.
# Copy to .env next to server.py and fill in the blanks.
# Values marked CHANGE_ME are secrets — generate/rotate them yourself and
# never commit the real .env.

# --- Core app ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=laislanublar
# Random long string; signs the site's session tokens (JWT).
JWT_SECRET=CHANGE_ME
PUBLIC_BASE_URL=https://laislanublar.net
FRONTEND_URL=https://laislanublar.net
CORS_ORIGINS=https://laislanublar.net

# --- Steam / admin ---
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=CHANGE_ME
# Comma-separated Steam64 IDs auto-promoted to site admin on login.
ADMIN_STEAM_IDS=
ALLOW_DEMO_LOGIN=0
SEED_DEMO_MARKET=0

# --- Evrima RCON (game chat/announce/kick/ban lanes) ---
RCON_HOST=127.0.0.1
RCON_PORT=8893
# Must match RconPassword in the game's Game.ini.
RCON_PASSWORD=CHANGE_ME

# --- Game log telemetry (same box) ---
ISLE_LOG_PATH=C:\Program Files (x86)\Steam\steamapps\common\The Isle Dedicated Server\TheIsle\Saved\Logs\TheIsle.log

# --- Discord (account link + role reads) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_GUILD_ID=1523167556368859286
DISCORD_VIP_ROLE_ID=
VIP_GRANT_ON_LINK=50
# Comma-separated Discord role IDs treated as Patreon tiers
# (gates paid skin application and the population unlock lane).
DISCORD_PATREON_ROLE_IDS=

# --- Patreon (optional direct integration) ---
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_ACCESS_TOKEN=

# --- Proximity voice (LiveKit) ---
# Public signal URL handed to browsers (through Caddy, NOT loopback):
LAISLANUBLAR_LIVEKIT_URL=wss://laislanublar.net/voice-ws
LAISLANUBLAR_LIVEKIT_API_KEY=CHANGE_ME
LAISLANUBLAR_LIVEKIT_API_SECRET=CHANGE_ME
LAISLANUBLAR_LIVEKIT_ROOM=laislanublar-voice
# Voice session token lifetime in seconds (default 86400 = 24h).
#LAISLANUBLAR_VOICE_TOKEN_TTL_SECS=86400

# --- Feature knobs (all optional; defaults shown) ---
# Cost in PrimeMeat per added/changed mutation in the vault mutation editor.
#LIN_MUTATION_EDIT_COST=20000
# Growth percentage (1-100) for store-bought dinos, both tiers.
#LIN_STORE_DINO_GROWTH=75
# Uses granted per glitch-skin crate win.
#LIN_GLITCH_USES_PER_WIN=25
# Vault cooldowns in seconds (0 = disabled).
#SLAY_COOLDOWN_SECS=0
#REDEEM_COOLDOWN_SECS=0
# Friend teleport cooldown in seconds (owner rule: 30 minutes; 0 disables).
#LIN_TELEPORT_COOLDOWN_SECS=1800
# Require identical species for friend teleports (1 = on).
#LIN_TELEPORT_SAME_SPECIES=1
# Population unlock lane: unlock duration + per-user cooldown (seconds).
#LIN_POP_UNLOCK_SECONDS=300
#LIN_POP_UNLOCK_COOLDOWN_SECONDS=3600
# Diet fraction (0-1) granted to population-respawn swapped dinos.
#LIN_SWAP_DIET_FRACTION=0.30
# Discord channel that receives public strike notices (Spanish embeds).
LIN_STRIKES_CHANNEL_ID=
# ---- Streamer Pack (free, application-only perk) ----
# Discord role that grants the streamer benefits. Empty = feature disabled.
DISCORD_STREAMER_ROLE_ID=1529887867793445045
# Staff-only channel the web posts applications into (with Approve/Reject buttons).
DISCORD_STREAMER_APPS_CHANNEL_ID=
# Amberium per bi-weekly payout for approved streamers.
#LIN_STREAMER_AMBER=20000
# PrimeMeat playtime multiplier for approved streamers.
#LIN_STREAMER_MULT=2.0
# Shared secret for the bot->web Approve/Reject callback. MUST equal the bot .env
# LIN_INTERNAL_KEY. Empty = the decision endpoint refuses everything (fail closed).
LIN_INTERNAL_KEY=CHANGE_ME
# Public Discord invite shown on the Streamer Pack section for users not yet in the
# guild ("Unirse al servidor" button). Empty = the button is hidden (text only).
DISCORD_INVITE_URL=
